# 行尾规范化
#
# ⚠️ META-INF/xposed/ 下的三个文件是 libxposed 的「逐行裸解析」输入：
#    java_init.list = 每行一个入口类名；scope.list = 每行一个作用域包名。
#    如果检出时被写成 CRLF，解析出的类名/包名会带一个回车符（\r），
#    框架找不到类 —— 表现是「模块装上了但完全没调起、日志里一个字都没有」。
#    所以这三个文件必须在任何机器上都保持 LF。
app/src/main/resources/META-INF/xposed/java_init.list text eol=lf
app/src/main/resources/META-INF/xposed/scope.list     text eol=lf
app/src/main/resources/META-INF/xposed/module.prop    text eol=lf

# Unix 侧构建入口（在 Linux/macOS/CI 上 CRLF 会直接报 bad interpreter）
gradlew text eol=lf

# 许可证全文：入库与工作区都保持 LF
#   它是纯文本、无功能依赖，但 Windows 上 core.autocrlf=true 会把工作区换成 CRLF，
#   会让「验证 LICENSE 是否被篡改」这类 sha256 比对平白多出一个变量，故钉死。
LICENSE text eol=lf

# 本文件自身也钉 LF：不然 core.autocrlf=true 会在下次 checkout 时把它变成 CRLF，
#   于是「管行尾的文件自己行尾不受管」—— 虽不影响功能（attr 解析器会剥尾随 \r），但会一直报警告
.gitattributes text eol=lf

# Windows 批处理必须保持 CRLF
*.bat text eol=crlf
